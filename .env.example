# ==========================================
# DISCORD BOT ENVIRONMENT CONFIGURATION
# ==========================================

# Môi trường chạy bot: development | production
NODE_ENV=development

# Discord Bot Token lấy từ Discord Developer Portal (https://discord.com/developers/applications)
# Mục: Bot -> Reset Token / Copy Token
DISCORD_TOKEN=your_discord_bot_token_here

# Client ID / Application ID của bot (lấy tại Discord Developer Portal -> General Information -> Application ID)
CLIENT_ID=your_client_id_here

# (Tùy chọn) ID server Discord dùng để test
# Để lấy ID: Bật Developer Mode -> Chuột phải vào icon Server -> Copy Server ID
GUILD_ID=your_guild_id_here

# ID của kênh Discord sẽ nhận thông báo khi có người VÀO server (Chào mừng)
# Để lấy ID: Bật Developer Mode trong cài đặt Discord -> Chuột phải vào kênh -> Copy Channel ID
WELCOME_CHANNEL_ID=your_welcome_channel_id_here

# ID của kênh Discord sẽ nhận thông báo khi có người RỜI server (Tạm biệt)
# (Nếu để trống, bot sẽ tự động gửi chung vào WELCOME_CHANNEL_ID)
LEAVE_CHANNEL_ID=your_leave_channel_id_here
