# ==========================================
# DISCORD BOT ENVIRONMENT CONFIGURATION
# ==========================================

# Môi trường chạy bot: development | production
NODE_ENV=development

# Discord Bot Token lấy từ Discord Developer Portal (https://discord.com/developers/applications)
# Mục: Bot -> Reset Token / Copy Token
DISCORD_TOKEN=your_discord_bot_token_here

# Client ID / Application ID của bot (lấy tại Discord Developer Portal -> General Information -> Application ID)
CLIENT_ID=your_client_id_here

# (Tùy chọn) ID server Discord dùng để test và đồng bộ Slash Commands tức thì khi phát triển
# Khi bỏ trống, bot tự động đăng ký Slash Commands toàn cục (Global) cho mọi Server bot tham gia
GUILD_ID=

# ==========================================
# CẤU HÌNH AI ASSISTANT (!ask & /ask)
# ==========================================
# Nhà cung cấp AI mặc định ban đầu: gemini | openrouter
AI_PRIMARY_PROVIDER=gemini

# Google Gemini API Key (Lấy tại: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# OpenRouter API Key (Dự phòng khi Gemini 429/lỗi: https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# Tavily AI Search API Key phục vụ tìm kiếm web thời gian thực RAG (Lấy tại: https://app.tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5

# Thời gian chờ tối đa cho 1 request AI (ms) và thời gian cooldown chống spam per user (ms)
AI_TIMEOUT_MS=60000
AI_COOLDOWN_MS=5000

# ==========================================
# LƯU Ý VỀ CẤU HÌNH SERVER (WELCOME / LEAVE / NHẠC / WHITELIST):
# ==========================================
# Toàn bộ cấu hình Kênh thông báo, Whitelist, Phân quyền kênh nhạc, Model AI & Tri thức Server
# được quản lý TRỰC TIẾP theo từng Server qua lệnh Discord:
# • /setup notify set type:<welcome|leave|all> channel:#kênh
# • /setup channel add channel:#kênh
# • /setup whitelist add target:<users|roles|channels> value:<tags/IDs>
# • /setup feature enable feature:<tên>
# • /setup ai set-model provider:<gemini|openrouter> model:<model>
# • /setup knowledge add-channel channel:#kênh
# Hoặc các lệnh Prefix tương ứng: !setup notify, !setup channel, !setup whitelist, !setup feature, !setup ai, !setup knowledge.


