# ==========================================
# DISCORD BOT ENVIRONMENT CONFIGURATION
# ==========================================

# Môi trường chạy bot: development | production
NODE_ENV=development

# Discord Bot Token lấy từ Discord Developer Portal (https://discord.com/developers/applications)
# Mục: Bot -> Reset Token / Copy Token
DISCORD_TOKEN=your_discord_bot_token_here

# Client ID / Application ID của bot (lấy tại Discord Developer Portal -> General Information -> Application ID)
CLIENT_ID=your_client_id_here

# (Tùy chọn) ID server Discord dùng để test và đồng bộ Slash Commands tức thì khi phát triển
# Khi bỏ trống, bot tự động đăng ký Slash Commands toàn cục (Global) cho mọi Server bot tham gia
GUILD_ID=

# LƯU Ý VỀ CẤU HÌNH KÊNH THÔNG BÁO (WELCOME / LEAVE):
# Kênh thông báo Chào mừng / Tạm biệt hiện tại được cấu hình TRỰC TIẾP theo từng Server qua câu lệnh:
# • /setup notify set type:welcome channel:#kênh
# • /setup notify set type:leave channel:#kênh
# • Hoặc lệnh prefix: s!setup notify welcome #kênh / s!setup welcome #kênh
# Mặc định: Nếu chưa cấu hình, bot sẽ tự động gửi vào Kênh hệ thống (System Channel) của Server.
